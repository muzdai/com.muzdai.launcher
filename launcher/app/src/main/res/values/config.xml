<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file and rebuild (cd launcher && ./gradlew assembleRelease).
  Every value here is the launcher's built-in default; Launcher settings on the TV store the owner's choices.
  Package names: on the TV run `pm list packages`.
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>ar.tvplayer.tv</item>
        <item>com.google.android.youtube.tv</item>
        <item>tv.emby.embyatv</item>
        <item>cc.alcopa.tv</item>
        <item>com.qobuz.music</item>
        <item>deezer.android.app</item>
        <item>ru.yourok.torrserve</item>
    </string-array>
    <!-- With fewer dock_apps than columns (or a dock app that is not installed), the free dock slots take
         the first grid apps, so the dock never shows a gap. false leaves them empty. -->
    <bool name="fill_dock">false</bool>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>

    <!-- An "Open on start" row in Launcher settings: pick any app on the TV, and the first time Home comes up
         after the TV starts it opens that app instead. Once per boot; Home after that stays Home, and an app that is
         gone or disabled leaves Home on screen. Off by default. -->
    <bool name="open_on_start_choice">false</bool>
    <!-- With open_on_start_choice: the picked app also opens each time the screen comes back on, for sets whose
         remote powers them into a light sleep with no boot. It opens over whatever was in front, an HDMI input
         included. Off by default. -->
    <bool name="open_on_start_on_wake">false</bool>

    <!-- Seconds the first Home after the TV starts waits for a working internet connection before it opens the
         Open on start app. A streaming app opened before the network is back shows an error, and after a power cut
         Wi-Fi can take minutes, as the router starts again too. Home stays on screen meanwhile, and leaving Home
         cancels the opening. 0, the default: open at once. Up to 600. -->
    <integer name="open_on_start_network_wait">0</integer>

    <!-- Tiles that open a screen of the app instead of its start screen: "package=action", sent to that package.
         A tile whose action no longer resolves opens the app normally. MagentaTV's program guide:
         com.telekom.onetv.tv.pl=com.telekom.onetv.tv.pl.action.PROGRAM_GUIDE. "package=input:<input id>" makes
         the tile switch to that TV input instead (ids from dumpsys tv_input), e.g. a Live TV tile straight to
         HDMI 1: com.mediatek.wwtv.tvcenter=input:com.mediatek.tvinput/.hdmi.HDMIInputService/HW5. "package=view:uri"
         opens that URI in the package instead (ACTION_VIEW): Bbox TV's live channels are
         fr.bouyguestelecom.tv.bbui=view:bbox://live. -->
    <string-array name="launch_actions">
    </string-array>

    <!-- A tile's name instead of the app's own: "package=Name". It also shows above the dock. -->
    <string-array name="app_labels">
    </string-array>
    <!-- A tile's artwork instead of the app's banner: "package=drawable", a banner_* drawable bundled with the
         launcher (res/drawable). banner_tv is a magenta field with the Live TV glyph. -->
    <string-array name="app_banners">
    </string-array>

    <!-- Whether InputKeyService actually requests key filtering. Some firmware (TCL Google TV on Android 12)
         drops key auto-repeat once ANY service filters keys, so long-pressing volume only steps once: set false and the
         service keeps running but stops filtering, which brings repeat back at the price of the remote buttons below
         doing nothing. -->
    <bool name="key_filter">true</bool>

    <!-- More remote buttons that open the input switcher, by Android keycode (KEYCODE_TV and KEYCODE_TV_INPUT
         always do). `dumpsys window policy` lists which app each such "global key" was routed to. Check with the real
         remote: keys injected over ADB never reach InputKeyService. Leave empty to omit. -->
    <integer-array name="input_key_keycodes">
    </integer-array>
    <!-- Remote buttons that open an app, as "keycode:package" or "KEYCODE_NAME:package" (InputKeyService; Home
         reads it too for vendor keys from 1000 up, which never reach the service). On Google TV the YouTube button
         sends 190 (KEYCODE_BUTTON_3) to the stock launcher, so it does nothing once launcherx is disabled:
         190:com.google.android.youtube.tv brings it back. A button told apart only by its scancode is listed as
         "scan:scancode:package", found with `adb shell getevent -lt` (the EV_KEY code, in hex); a scancode entry wins
         over a keycode. In place of a package, "input:<input id>" switches to that TV input (ids from
         `adb shell dumpsys tv_input`), "tuner" to the TV's tuner, "inputs" opens the Inputs menu on Home and
         "inputs_overlay" the Inputs list over the app on screen. An action word runs that action instead: back, home,
         recents, mute (toggles the sound, with the TV's volume bar), sleep (standby), screensaver (the one chosen in
         the TV's settings), settings, wifi, library (Home with the App library open) or ignore (swallows the button,
         for a shortcut pressed by accident). "package/.Activity" opens that activity instead of the app's launcher
         entry. Prefix an entry with "hold:" for the same button's long press: "hold:KEYCODE_BUTTON_8:org.xbmc.kodi"
         opens Kodi when held for half a second, while the unprefixed entry still opens on a tap; "hold:scan:490:..."
         works for scancodes. A key with only a hold entry does nothing on a tap. A listed app that is not installed
         leaves the button doing nothing. The owner's choices in Launcher settings (Remote buttons) win over this list. -->
    <string-array name="app_keys" translatable="false">
        <!-- vPro, TCL Google TV remote: gear, YouTube, Input, TV. -->
        <item>83:com.muzdai.launcher/.QuickSettingsActivity</item>
        <item>190:com.google.android.youtube.tv</item>
        <item>178:inputs_overlay</item>
        <item>4001:tuner</item>
    </string-array>
    <!-- The date on its own line under the clock instead of beside it, for a top bar whose pills leave the
         date too little room. -->
    <bool name="date_below_clock">false</bool>

    <!-- A name after the greeting: "Anna" shows GOOD MORNING, ANNA. Empty: the greeting alone. -->
    <string name="greeting_name" translatable="false"></string>
    <!-- The greeting above the clock ("Good evening"). false hides it. -->
    <bool name="show_greeting">true</bool>
    <!-- The date and the line between the clock and the date in the clock's full white instead of dimmed. -->
    <bool name="header_white">true</bool>
    <!-- The dock as its own row: a lighter band, no names under the tiles, parked low on the screen with the top
         shelf above it. false makes the dock apps simply the first tiles of one plain grid (still in dock_apps
         order, no empty slots), with names under every tile. -->
    <bool name="dock_row">true</bool>
    <!-- A direct Launcher settings action instead of TV Settings in the header. Off by default. -->
    <bool name="launcher_settings_button">false</bool>
    <!-- The dock band as light frosted glass, like the Inputs, Wi-Fi and Settings pills, so the wallpaper shows
         through it. false keeps the solid near-black band. -->
    <bool name="dock_glass">true</bool>
    <!-- Draw the dock band and its edge. false leaves the tiles floating on the wallpaper (config.xml dock_band). -->
    <bool name="dock_band">true</bool>
    <!-- The dock band's padding equals the gap between its tiles on all four sides (as far as the grid's edges leave room),
         so its corners are concentric with the tiles' and the spacing reads even. false (the default) keeps the fixed
         14dp above and below, up to 22dp at the sides and 26dp corners. -->
    <bool name="dock_even_padding">true</bool>
    <!-- Wi-Fi and Settings as round icon-only buttons (the network name moves to the talkback description);
         Inputs keeps its label. -->
    <bool name="icon_only_buttons">true</bool>
    <!-- The Inputs pill as a round icon button too (the label moves to the talkback description). -->
    <bool name="icon_only_inputs">true</bool>
    <!-- The launcher's clocks (Home and the clock screensaver) in 12- or 24-hour time whatever the TV is set to:
         "12", "24", or "system", the default, which follows the TV. Launcher settings' Clock row overrides it. -->
    <string name="clock_format" translatable="false">system</string>
    <!-- true colours the Wi-Fi pill's icon green while the TV is online and leaves it white while it is not (dark on
         the focused pill either way), so the connection shows at a glance, also as an icon-only button. -->
    <bool name="wifi_status_color">false</bool>
    <!-- With wifi_status_color: the icon orange while the TV is connected but Android has not reached the internet
         through it (a hotel or holiday-park Wi-Fi waiting for its login page) and red while it is offline, instead
         of white for both. -->
    <bool name="wifi_status_warnings">false</bool>
    <!-- The app library as a round button in the top bar, beside Settings (app_library must be on too). -->
    <bool name="library_button">true</bool>
    <!-- The App library pill after the last Home row. false hides it while library_button is on, so the top-bar
         button stays the way in, and Down from the last row stays put as with app_library off. -->
    <bool name="show_library_pill">false</bool>
    <!-- With icon_only_buttons: keep the network name on the Wi-Fi pill up to this width in dp, cut with an ellipsis.
         0 leaves the Wi-Fi pill as an icon. -->
    <integer name="wifi_label_width">0</integer>

    <!-- The Wi-Fi/Ethernet pill in the top bar. false hides it (on Android 14 with Location off it can
         only say "Wi-Fi", not the network name). -->
    <bool name="show_network_pill">true</bool>
    <!-- Apps shown as round buttons with their own logo in the top bar, left of the network pill, in this order.
         They leave the grid. Missing apps are skipped. -->
    <string-array name="top_bar_apps" translatable="false">
    </string-array>
    <!-- The Inputs pill in the top bar, shown when the TV has inputs to list. false hides it for good; what the
         remote's Input button does is unchanged. -->
    <bool name="show_inputs_pill">true</bool>
    <!-- The Inputs list shows only HDMI ports and CEC devices that report connected. Empty ports, devices asleep in
         standby (some TVs, TCL among them, report an empty HDMI port as connected-standby, the same state a
         sleeping device has) and the AV jacks fold behind a "More inputs" row that expands the rest. An HDMI row
         whose state the TV cannot be trusted with stays. Off by default: every input is listed. -->
    <bool name="inputs_connected_only">false</bool>
    <!-- Only CEC device rows in the Inputs list show a connection state ("Steam Deck · HDMI 1  Connected"); bare HDMI
         ports show none. For TVs whose port states land on the wrong port: TCL UnionTV (Android 9) reports the empty
         HDMI 1 as connected and a device on HDMI 2 nowhere, while its CEC device list stays right. A device without
         CEC then shows no state at all. Off by default. -->
    <bool name="inputs_cec_state_only">false</bool>
    <!-- Names under every tile, not only the focused one: unfocused names stay dimmed, the focused one is full white.
         With dock_row the band grows down to hold the dock's names too. -->
    <bool name="always_show_names">false</bool>
    <!-- Wallpapers decode as RGB_565 (2 bytes a pixel, 4 MB at 1080p), which bands dark gradients such as a night
         sky, most of all under wallpaper_dim. true decodes them in 32-bit colour: 8 MB, for TVs with 2 GB or more. -->
    <bool name="wallpaper_true_color">false</bool>
    <!-- Rotating wallpapers: show each picture's name under the top-right buttons, from a captions.txt next to the
         pictures in wallpapers/ ("01-dusk.jpg<TAB>Dusk over the peaks", one per line). A picture without a line
         shows no name. -->
    <bool name="wallpaper_captions">true</bool>
    <!-- Rotating wallpapers grouped by the time of day, as JSON: {"morning": [file names], "evening": [...],
         "night": [...]}. While set, the rotation picks only from the group that fits now: morning from sunrise to
         noon, evening until half an hour after sunset, night the rest, with the sun at latitude and longitude (07:00
         and 18:30 without them). It moves to the new group as soon as the time of day changes. A missing or empty
         group falls back to the whole collection; empty rotates through every picture. -->
    <string name="wallpaper_moods" translatable="false"></string>
    <!-- Hold OK on a tile opens a small menu: Move (picks the tile up for reordering), Close, Remove from Home
         (only with app_library) and App info. false: holding OK opens the app's App info page. -->
    <bool name="tile_menu">true</bool>

    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. Tiles shrink if
         the dock, its title and this many rows would not otherwise fit the screen height. -->
    <integer name="rows_below_dock">0</integer>

    <!-- The focused dock app's name in large type above the dock. false leaves room for bigger tiles when
         rows_below_dock is 2 or 3. -->
    <bool name="dock_title">true</bool>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">7</integer>

    <!-- Basic motion is on; advanced effects are opt-in in the launcher's own Settings screen. -->
    <bool name="animations">true</bool>
    <bool name="advanced_effects">false</bool>

    <!-- Optional Default-home tile; keep this key for tile-ordering work.
         Off by default because the chooser is also available from launcher settings. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- The App library: every installed launchable app, including ordinary Android apps. -->
    <bool name="app_library">true</bool>
    <!-- Optional direct Home picker in the app library: OK toggles the checkmark, checked apps first.
         Off by default. -->
    <bool name="app_library_selection">false</bool>
    <!-- OK opens every app in the library, not only the apps on Home: for a library that holds the apps kept off Home with hidden_apps. Hold OK still offers Add to Home. app_library_selection wins when both are
         on. Off by default. -->
    <bool name="library_ok_opens">true</bool>

    <!-- Apps pre-seeded into the App library's "added" set at startup. They show on Home as if the owner had
         added them in the App library, and stay removable there (a removed one stays hidden). Empty by default. -->
    <string-array name="library_apps" translatable="false">
    </string-array>

    <!-- Packages the App library catalogue never offers. Different from hidden_apps, which only keeps a
         package off Home while still listing it in the library. Empty by default. -->
    <string-array name="library_excluded_apps" translatable="false">
    </string-array>
    <!-- Where the TV is, in decimal degrees, so wallpaper_moods follows the real sunrise and sunset (computed on
         the TV, no network). Empty: 07:00 and 18:30. -->
    <string name="latitude" translatable="false"></string>
    <string name="longitude" translatable="false"></string>
    <!-- The clock screensaver over Home's wallpaper instead of black with a coloured glow. The clock still moves
         every minute. -->
    <bool name="clock_wallpaper">true</bool>
    <!-- How dark that wallpaper is behind the clock, 0 to 90 %. -->
    <integer name="clock_wallpaper_dim">25</integer>
    <!-- The clock screensaver's slow coloured glow behind the clock. false leaves the clock and date alone on plain black
         (OLED panels); they still move every minute. Ignored while clock_wallpaper shows a picture. -->
    <bool name="clock_glow">true</bool>
    <!-- The focus highlight's look: glass (the default: a translucent slab with a bright top sheen, a crisp rim and a
         faint outer glow), rim (the crisp rim alone, no sheen, fill or glow, for a quiet focus over a wallpaper) or
         halo (the rim with a lighter outer glow). -->
    <string name="glass_style" translatable="false">glass</string>

    <!-- Tiles drawn from the app's icon and name instead of its banner (for banners that crop badly). -->
    <string-array name="icon_tiles" translatable="false">
    </string-array>
</resources>
