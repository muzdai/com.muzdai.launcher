<?xml version="1.0" encoding="utf-8"?>
<!-- Voice search (VoiceSearchActivity): a glass panel at the bottom of the screen, over Home. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/glass_panel"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/mic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="15dp"
                android:src="@drawable/ic_mic"
                android:tint="@drawable/pill_text"
                android:background="@drawable/voice_mic_bg"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/voice_search" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/voice_query_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:hint="@string/voice_hint_type"
                    android:textColorHint="#80FFFFFF"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@string/font_regular"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="10dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@string/font_body"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Results: rows like the other glass menus, or the "not installed" card. -->
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/missing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/missingIcon"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/missingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:id="@+id/missingSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@string/font_body"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/missingPlay"
                        style="@style/TopButton"
                        android:layout_marginStart="0dp"
                        android:text="@string/voice_play_market" />

                    <TextView
                        android:id="@+id/missingCancel"
                        style="@style/TopButton"
                        android:text="@string/cancel" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
